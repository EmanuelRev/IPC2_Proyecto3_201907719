@page
@model FrontendWeb.Pages.EstadoCuentaModel
@{
    ViewData["Title"] = "Estado de Cuenta";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="text-center mb-4">
    <h1 class="display-4">Estado de Cuenta de Clientes</h1>
    <p>Consulta el saldo y el historial detallado de transacciones por cliente.</p>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-danger">
                <strong>¡Ocurrió un error!</strong> @Model.MensajeError
            </div>
        </div>
    </div>
}

<div class="row mb-3">
    <div class="col-md-8 offset-md-2 d-flex gap-2">
        <input type="text" id="buscadorNIT" class="form-control form-control-lg" placeholder="Buscar por NIT..." onkeyup="filtrarTabla()">
        <button class="btn btn-danger btn-lg px-4" onclick="generarPDF()">
           Descargar PDF
        </button>
    </div>
</div>

<div id="zonaPDF" class="p-3 bg-white">
    <div class="text-center mb-4 d-none" id="tituloPDF">
        <h2>Reporte de Estado de Cuenta - ITGSA</h2>
        <hr />
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered table-striped" id="tablaClientes">
            <thead class="table-dark">
                <tr>
                    <th>NIT</th>
                    <th>Nombre del Cliente</th>
                    <th>Total Pagado</th>
                    <th>Saldo a Favor</th>
                    <th class="no-print">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clientes != null && Model.Clientes.Count > 0)
                {
                    foreach (var cliente in Model.Clientes)
                    {
                        <tr>
                            <td class="fw-bold">@cliente.nit</td>
                            <td>@cliente.nombre</td>
                            <td class="text-success">Q @cliente.totalPagado.ToString("0.00")</td>
                            <td class="text-primary">Q @cliente.saldoAFavor.ToString("0.00")</td>
                            <td class="no-print">
                                <button class="btn btn-sm btn-outline-primary" onclick='verDetalle(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(cliente)))'>
                                    Ver Historial
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No hay clientes cargados en el sistema.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalHistorial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitulo">Historial de Transacciones</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Referencia</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="contenidoHistorial"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>

<script>
    function filtrarTabla() {
        var input = document.getElementById("buscadorNIT");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("tablaClientes");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var td = tr[i].getElementsByTagName("td")[0]; 
            if (td) {
                var txtValue = td.textContent || td.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }

    function verDetalle(cliente) {
        document.getElementById("modalTitulo").innerText = "Historial: " + cliente.nombre + " (" + cliente.nit + ")";
        var cuerpo = document.getElementById("contenidoHistorial");
        cuerpo.innerHTML = "";

        if (cliente.historial && cliente.historial.length > 0) {
            cliente.historial.forEach(function(item) {
                var fila = document.createElement("tr");
                var esFactura = item.hasOwnProperty('numero');
                
                var fecha = esFactura ? item.fecha : item.fecha;
                var tipo = esFactura ? '<span class="badge bg-warning text-dark">FACTURA</span>' : '<span class="badge bg-success">PAGO</span>';
                var ref = esFactura ? "No. " + item.numero : "Abono a Cuenta";
                var monto = esFactura ? item.total : item.importe;

                fila.innerHTML = `
                    <td>${fecha}</td>
                    <td>${tipo}</td>
                    <td>${ref}</td>
                    <td class="text-end fw-bold">Q ${monto.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                `;
                cuerpo.appendChild(fila);
            });
        } else {
            cuerpo.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Sin movimientos registrados.</td></tr>';
        }

        var myModal = new bootstrap.Modal(document.getElementById('modalHistorial'));
        myModal.show();
    }

    function generarPDF() {
        var elemento = document.getElementById('zonaPDF');
        var botones = elemento.querySelectorAll('.no-print');
        botones.forEach(b => b.style.display = 'none');
        
        document.getElementById('tituloPDF').classList.remove('d-none');

        var opciones = {
            margin: 10,
            filename: 'EstadoCuenta_ITGSA.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        html2pdf().set(opciones).from(elemento).save().then(function() {
            document.getElementById('tituloPDF').classList.add('d-none');
            botones.forEach(b => b.style.display = '');
        });
    }
</script>